rong></td> </tr><tr class="zone-relegation"> <td class="num">18</td> <td>Real Valladolid</td> <td class="num">38</td> <td class="num">6</td> <td class="num">14</td> <td class="num">18</td> <td class="num">29</td> <td class="num">52</td> <td class="num">-23</td> <td class="num"><strong>32</strong></td> </tr><tr class="zone-relegation"> <td class="num">19</td> <td>Espanyol</td> <td class="num">38</td> <td class="num">6</td> <td class="num">13</td> <td class="num">19</td> <td class="num">32</td> <td class="num">58</td> <td class="num">-26</td> <td class="num"><strong>31</strong></td> </tr><tr class="zone-relegation"> <td class="num">20</td> <td>Elche</td> <td class="num">38</td> <td class="num">4</td> <td class="num">13</td> <td class="num">21</td> <td class="num">26</td> <td class="num">63</td> <td class="num">-37</td> <td class="num"><strong>25</strong></td> </tr> </tbody> </table> </div> <div class="table-legend" aria-label="Table legend"> <span><span class="dot dot-cl"></span> Champions League</span> <span><span class="dot dot-el"></span> Europa League</span> <span><span class="dot dot-ecl"></span> Conference League</span> <span><span class="dot dot-rel"></span> Relegation</span>  </div> </section> <section class="section" id="scorers"><h2 class="section-title">Top Scorers</h2><div class="table-wrap" role="region" aria-label="Top scorers table" tabindex="0"><table class="stats-table" aria-label="Top Scorers"><thead><tr><th class="num" scope="col">#</th><th scope="col">Player</th><th scope="col">Club</th><th class="num" scope="col">Goals</th><th class="num" scope="col">Assists</th></tr></thead><tbody><tr><td class="num">1</td><td>Robert Lewandowski</td><td>Barcelona</td><td class="num"><strong>23</strong></td><td class="num">6</td></tr><tr><td class="num">2</td><td>Karim Benzema</td><td>Real Madrid</td><td class="num"><strong>19</strong></td><td class="num">4</td></tr><tr><td class="num">3</td><td>Antoine Griezmann</td><td>Atletico Madrid</td><td class="num"><strong>15</strong></td><td class="num">7</td></tr><tr><td class="num">4</td><td>Joselu</td><td>Espanyol</td><td class="num"><strong>14</strong></td><td class="num">2</td></tr><tr><td class="num">5</td><td>Borja Iglesias</td><td>Real Betis</td><td class="num"><strong>13</strong></td><td class="num">3</td></tr><tr><td class="num">6</td><td>Iago Aspas</td><td>Celta Vigo</td><td class="num"><strong>13</strong></td><td class="num">5</td></tr><tr><td class="num">7</td><td>Alvaro Morata</td><td>Atletico Madrid</td><td class="num"><strong>12</strong></td><td class="num">4</td></tr><tr><td class="num">8</td><td>Vinicius Junior</td><td>Real Madrid</td><td class="num"><strong>11</strong></td><td class="num">5</td></tr><tr><td class="num">9</td><td>Raphinha</td><td>Barcelona</td><td class="num"><strong>10</strong></td><td class="num">6</td></tr><tr><td class="num">10</td><td>Mikel Oyarzabal</td><td>Real Sociedad</td><td class="num"><strong>10</strong></td><td class="num">3</td></tr></tbody></table></div></section> <section class="section" id="assists"><h2 class="section-title">Top Assisters</h2><div class="table-wrap" role="region" aria-label="Top assisters table" tabindex="0"><table class="stats-table" aria-label="Top assisters"><thead><tr><th class="num" scope="col">#</th><th scope="col">Player</th><th scope="col">Club</th><th class="num" scope="col">Assists</th></tr></thead><tbody><tr><td class="num">1</td><td>Antoine Griezmann</td><td>Atletico Madrid</td><td class="num"><strong>7</strong></td></tr><tr><td class="num">2</td><td>Robert Lewandowski</td><td>Barcelona</td><td class="num"><strong>6</strong></td></tr><tr><td class="num">3</td><td>Raphinha</td><td>Barcelona</td><td class="num"><strong>6</strong></td></tr><tr><td class="num">4</td><td>Vinicius Junior</td><td>Real Madrid</td><td class="num"><strong>5</strong></td></tr><tr><td class="num">5</td><td>Iago Aspas</td><td>Celta Vigo</td><td class="num"><strong>5</strong></td></tr></tbody></table></div></section> <section class="section" id="clean-sheets"><h2 class="section-title">Clean Sheet Leaders</h2><div class="table-wrap" role="region" aria-label="Clean sheet leaders table" tabindex="0"><table class="stats-table" aria-label="Clean sheet leaders"><thead><tr><th class="num" scope="col">#</th><th scope="col">Goalkeeper</th><th scope="col">Club</th><th class="num" scope="col">Clean Sheets</th></tr></thead><tbody><tr><td class="num">1</td><td>Marc-Andre ter Stegen</td><td>Barcelona</td><td class="num"><strong>18</strong></td></tr><tr><td class="num">2</td><td>Jan Oblak</td><td>Atletico Madrid</td><td class="num"><strong>14</strong></td></tr><tr><td class="num">3</td><td>Thibaut Courtois</td><td>Real Madrid</td><td class="num"><strong>13</strong></td></tr><tr><td class="num">4</td><td>Alex Remiro</td><td>Real Sociedad</td><td class="num"><strong>12</strong></td></tr><tr><td class="num">5</td><td>Unai Simon</td><td>Athletic Bilbao</td><td class="num"><strong>10</strong></td></tr></tbody></table></div></section> <div class="section"><h2 class="section-title">Season Awards</h2><div class="awards-grid"><div class="award-card"><div class="award-title">Pichichi (Top Scorer)</div><div class="award-winner">Robert Lewandowski</div></div><div class="award-card"><div class="award-title">Best Goalkeeper (Zamora)</div><div class="award-winner">Marc-Andre ter Stegen</div></div><div class="award-card"><div class="award-title">Best Coach</div><div class="award-winner">Xavi Hernandez</div></div><div class="award-card"><div class="award-title">Best Player</div><div class="award-winner">Robert Lewandowski</div></div></div></div> <section class="section" id="review"> <h2 class="section-title">Season Review</h2> <div class="narrative"> <p>Barcelona stormed to the 2022-23 La Liga title under Xavi Hernandez, finishing on 88 points and effectively wrapping up the championship with weeks to spare. It was a statement of intent from a club that had endured turbulent years of financial difficulty and on-pitch decline.</p><p>The arrival of Robert Lewandowski from Bayern Munich proved transformative. The Polish striker scored 23 league goals to claim the Pichichi trophy and brought a clinical edge that Barcelona had lacked since the departure of Luis Suarez. His partnership with Ousmane Dembele, Raphinha and the emerging talent of Pedri gave Barcelona an attacking potency that no other side could match consistently.</p><p>Real Madrid finished second on 78 points in what proved to be Karim Benzema&#39;s final season at the Bernabeu. The Frenchman, fresh from his Ballon d&#39;Or triumph, scored 19 league goals but the team lacked the consistency to mount a serious title challenge. Benzema&#39;s emotional farewell at the end of the season marked the end of an era for Los Blancos.</p><p>Atletico Madrid enjoyed a solid campaign under Diego Simeone, finishing third on 77 points. Antoine Griezmann was the standout performer with 15 goals and 7 assists, his creative spark complementing the goals of Alvaro Morata and Memphis Depay. Real Sociedad secured a remarkable fourth-place finish and Champions League qualification, continuing their emergence as a genuine force in Spanish football.</p><p>Marc-Andre ter Stegen was exceptional between the posts for Barcelona, keeping 18 clean sheets and conceding just 20 goals all season. The German&#39;s form was a cornerstone of Barcelona&#39;s defensive solidity and he was deservedly named the Zamora Trophy winner as La Liga&#39;s best goalkeeper.</p><p>At the bottom of the table, Elche endured a miserable campaign, collecting just 25 points and finishing rock bottom. Espanyol and Real Valladolid joined them in relegation, with both clubs struggling to find consistency throughout the season.</p><p>Sevilla endured a disappointing domestic campaign, finishing twelfth, though they did manage to win the Europa League for a record-extending seventh time, beating Roma in the final in Budapest.</p><p>Barcelona&#39;s title triumph was a reminder of the club&#39;s enduring quality and Xavi&#39;s growing reputation as a coach. With a young core built around Pedri, Gavi and emerging talents, the future looked bright at Camp Nou.</p> </div> </section> <div class="section"> <h2 class="section-title">Relegation & Promotion</h2> <div class="transfer-section"> <div class="transfer-box relegated"> <h4>Relegated</h4> <ul> <li>Elche</li><li>Espanyol</li><li>Real Valladolid</li> </ul> </div> <div class="transfer-box promoted"> <h4>Promoted (replacing)</h4> <ul> <li>Las Palmas</li><li>Granada</li><li>Alaves</li> </ul> </div> </div> </div> <section class="section"> <h2 class="section-title">Notable Moments</h2> <ul class="moments-list"> <li>Barcelona clinched the title with several weeks to spare under Xavi Hernandez</li><li>Robert Lewandowski won the Pichichi with 23 goals in his debut La Liga season</li><li>Karim Benzema played his final season at Real Madrid before departing for Saudi Arabia</li><li>Sevilla won the Europa League for a record-extending seventh time</li><li>Real Sociedad qualified for the Champions League for the first time since 2013</li> </ul> </section>  <nav class="season-nav" aria-label="Season navigation"> <a href="/la-liga/2021-22/">&larr; 2021-22</a> <a href="/la-liga/">All La Liga seasons</a> <a href="/la-liga/2023-24/">2023-24 &rarr;</a> </nav> </div>  </main> <footer class="site-footer" role="contentinfo"> <div class="container"> <div class="footer-grid"> <div class="footer-brand"> <a href="/" class="site-logo" style="color:#fff;font-size:1.1rem;"> <img class="logo-mark" src="/brand-mark.svg" alt="" width="34" height="34"> <span class="logo-text">last<span>season</span></span> </a> <p>Historical football data archived. Final tables, top scorers, season reviews for leagues across Europe and beyond.</p> </div> <div> <div class="footer-heading">Leagues</div> <ul class="footer-link-list"> <li><a href="/premier-league/">Premier League</a></li> <li><a href="/championship/">Championship</a></li> <li><a href="/la-liga/">La Liga</a></li> <li><a href="/bundesliga/">Bundesliga</a></li> <li><a href="/serie-a/">Serie A</a></li> <li><a href="/ligue-1/">Ligue 1</a></li> </ul> </div> <div> <div class="footer-heading">Site</div> <ul class="footer-link-list"> <li><a href="/tools/">Interactive Tools</a></li> <li><a href="/fantasy-football/">Fantasy Football Helpers</a></li> <li><a href="/daily/">Daily Football Game</a></li> <li><a href="/games/">More Football Games</a></li> <li><a href="/on-this-day/">On This Day</a></li> <li><a href="/my/">My Last Season</a></li> <li><a href="/scores/">Latest Scores & Fixtures</a></li> <li><a href="/compare/">Season Comparisons</a></li> <li><a href="/football-shirts/">Football Shirt Buying Guide</a></li> <li><a href="/search/">Search</a></li> <li><a href="/kits/">Kit Colour Archive</a></li> <li><a href="/records/">Records & Stats</a></li> <li><a href="/faq/">Football FAQ</a></li> <li><a href="/clubs/">All Clubs</a></li> <li><a href="/players/">All Players</a></li> </ul> </div> <div> <div class="footer-heading">Trust</div> <ul class="footer-link-list"> <li><a href="/about/">About</a></li> <li><a href="/methodology/">Methodology & Sources</a></li> <li><a href="/corrections/">Corrections</a></li> <li><a href="/partners/">Data & Partnerships</a></li> <li><a href="/terms/">Terms of Use</a></li> <li><a href="/privacy/">Privacy Policy</a></li> <li><a href="/cookies/">Cookie Policy</a></li> <li><button class="footer-choice-button" type="button" data-reset-analytics>Privacy choices</button></li> </ul> </div> </div> <div class="footer-bottom"> <p class="footer-legal">&copy; 2026 lastseason.co.uk</p> <p class="footer-legal">Independent football archive. Corrections are welcomed and logged.</p> </div> </div> </footer> <aside class="privacy-choice" id="privacy-choice" hidden aria-label="Privacy choices" aria-live="polite"> <div> <strong>Your privacy choices</strong> <p>We use optional, privacy-conscious analytics to understand which archive pages are useful. No advertising trackers are loaded.</p> <a href="/cookies/">Cookie details</a> </div> <div class="privacy-choice-actions"> <button type="button" data-analytics-choice="denied">Reject analytics</button> <button type="button" class="privacy-accept" data-analytics-choice="granted">Allow analytics</button> </div> </aside> <script>
      const toggle = document.getElementById("nav-toggle");
      const nav = document.getElementById("mobile-nav");
      if (toggle && nav) {
        toggle.addEventListener("click", () => {
          const open = nav.classList.toggle("is-open");
          toggle.setAttribute("aria-expanded", String(open));
          document.body.classList.toggle("nav-open", open);
        });
      }

      const searchDrawer = document.getElementById("search-drawer");
      const globalSearch = document.getElementById("global-search");
      const openSearch = () => {
        if (!searchDrawer) return;
        searchDrawer.hidden = false;
        document.body.classList.add("search-open");
        requestAnimationFrame(() => globalSearch?.focus());
      };
      const closeSearch = () => {
        if (!searchDrawer) return;
        searchDrawer.hidden = true;
        document.body.classList.remove("search-open");
      };
      document.querySelectorAll("[data-search-toggle]").forEach((button) => button.addEventListener("click", openSearch));
      document.querySelectorAll("[data-search-close]").forEach((button) => button.addEventListener("click", closeSearch));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeSearch();
          nav?.classList.remove("is-open");
          toggle?.setAttribute("aria-expanded", "false");
          document.body.classList.remove("nav-open");
        }
        if (event.key === "/" && !event.metaKey && !event.ctrlKey && !event.altKey && !["INPUT", "TEXTAREA", "SELECT"].includes(document.activeElement?.tagName || "")) {
          event.preventDefault(); openSearch();
        }
      });

      const pagePath = document.body.dataset.pagePath;
      const pageTitle = document.body.dataset.pageTitle;
      if (pagePath && pagePath !== "/" && pageTitle) {
        try {
          const key = "lastseason-history";
          const history = JSON.parse(localStorage.getItem(key) || "[]").filter((item) => item.path !== pagePath);
          history.unshift({ path: pagePath, title: pageTitle, visitedAt: Date.now() });
          localStorage.setItem(key, JSON.stringify(history.slice(0, 6)));
        } catch {}
      }

      const favouriteKey = "lastseason-favourite-leagues";
      const readFavourites = () => {
        try { return JSON.parse(localStorage.getItem(favouriteKey) || "[]"); } catch { return []; }
      };
      const syncFavouriteButtons = () => {
        const favourites = readFavourites();
        document.querySelectorAll("[data-favourite-league]").forEach((button) => {
          const active = favourites.includes(button.dataset.favouriteLeague);
          button.setAttribute("aria-pressed", String(active));
          button.classList.toggle("is-favourite", active);
          const label = active ? "Remove from my leagues" : "Save to my leagues";
          button.setAttribute("aria-label", label);
          const text = button.querySelector("[data-favourite-label]");
          if (text) text.textContent = active ? "Saved" : "Save league";
        });
      };
      document.querySelectorAll("[data-favourite-league]").forEach((button) => button.addEventListener("click", () => {
        const favourites = readFavourites();
        const slug = button.dataset.favouriteLeague;
        const next = favourites.includes(slug) ? favourites.filter((item) => item !== slug) : [...favourites, slug];
        try { localStorage.setItem(favouriteKey, JSON.stringify(next)); } catch {}
        syncFavouriteButtons();
        document.dispatchEvent(new CustomEvent("lastseason:favourites"));
      }));
      syncFavouriteButtons();

      const favouriteClubKey = "lastseason-favourite-clubs";
      const readFavouriteClubs = () => {
        try { return JSON.parse(localStorage.getItem(favouriteClubKey) || "[]"); } catch { return []; }
      };
      const syncFavouriteClubButtons = () => {
        const favourites = readFavouriteClubs();
        document.querySelectorAll("[data-favourite-club]").forEach((button) => {
          const active = favourites.includes(button.dataset.favouriteClub);
          button.setAttribute("aria-pressed", String(active));
          button.classList.toggle("is-favourite", active);
          const text = button.querySelector("[data-favourite-club-label]");
          if (text) text.textContent = active ? "Following" : (button.dataset.clubName ? `Follow ${button.dataset.clubName}` : "Follow club");
        });
      };
      document.querySelectorAll("[data-favourite-club]").forEach((button) => button.addEventListener("click", () => {
        const favourites = readFavouriteClubs();
        const slug = button.dataset.favouriteClub;
        const next = favourites.includes(slug) ? favourites.filter((item) => item !== slug) : [...favourites, slug];
        try { localStorage.setItem(favouriteClubKey, JSON.stringify(next)); } catch {}
        syncFavouriteClubButtons();
      }));
      syncFavouriteClubButtons();
      document.querySelectorAll(".table-wrap").forEach(wrap => {
        const check = () => wrap.classList.toggle("is-scrollable", wrap.scrollWidth > wrap.clientWidth + 2);
        check();
        window.addEventListener("resize", check);
      });

      const analyticsKey = "lastseason-analytics-choice";
      const analyticsVisitorKey = "lastseason-analytics-visitor";
      const privacyChoice = document.getElementById("privacy-choice");
      let firstPartyPageViewSent = false;
      const fantasyCompletionEvents = new Set([
        "fantasy_name_copy",
        "fantasy_name_save",
        "fantasy_name_share",
        "fantasy_league_name_save",
        "fantasy_squad_generate",
        "fantasy_plan_save",
        "fantasy_squad_download",
        "fantasy_reminder_download",
      ]);
      const analyticsAllowed = () => {
        try { return localStorage.getItem(analyticsKey) === "granted"; } catch { return false; }
      };
      const analyticsVisitorId = () => {
        if (!analyticsAllowed()) return "";
        try {
          let id = localStorage.getItem(analyticsVisitorKey);
          if (!/^[a-zA-Z0-9-]{16,64}$/.test(id || "")) {
            id = typeof crypto.randomUUID === "function"
              ? crypto.randomUUID()
              : `${Date.now()}-${Math.random().toString(36).slice(2)}-${Math.random().toString(36).slice(2)}`;
            localStorage.setItem(analyticsVisitorKey, id);
          }
          return id;
        } catch {
          return "";
        }
      };
      const sendFirstPartyEvent = (eventName, parameters = {}) => {
        const visitorId = analyticsVisitorId();
        if (!visitorId) return false;
        const eventId = typeof crypto.randomUUID === "function"
          ? crypto.randomUUID()
          : `${Date.now()}-${Math.random().toString(36).slice(2)}-${Math.random().toString(36).slice(2)}`;
        const body = JSON.stringify({
          eventId,
          eventName,
          visitorId,
          pagePath: window.location.pathname,
          parameters,
        });
        try {
          fetch("/api/analytics", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body,
            keepalive: true,
          }).catch(() => {});
          return true;
        } catch {
          return false;
        }
      };
      window.lsTrack = (eventName, parameters = {}) => {
        const eventParameters = {
          page_path: window.location.pathname,
          page_title: document.body.dataset.pageTitle || document.title,
          ...parameters,
        };
        const firstPartySent = sendFirstPartyEvent(eventName, parameters);
        const googleReady = typeof window.gtag === "function" && analyticsAllowed();
        if (googleReady) window.gtag("event", eventName, eventParameters);
        if (fantasyCompletionEvents.has(eventName)) {
          const completionParameters = {
            ...eventParameters,
            completion_type: eventName,
          };
          sendFirstPartyEvent("fantasy_tool_complete", completionParameters);
          if (googleReady) window.gtag("event", "fantasy_tool_complete", completionParameters);
        }
        return firstPartySent || googleReady;
      };
      const loadAnalytics = () => {
        if (!document.querySelector('script[data-lastseason-analytics]')) {
          window.dataLayer = window.dataLayer || [];
          window.gtag = function(){ window.dataLayer.push(arguments); };
          window.gtag("js", new Date());
          window.gtag("config", "G-C2K4PMZEDJ", {
            anonymize_ip: true,
            page_location: window.location.href,
            page_path: window.location.pathname + window.location.search,
            page_title: document.title,
          });
          const script = document.createElement("script");
          script.async = true;
          script.dataset.lastseasonAnalytics = "true";
          script.src = "https://www.googletagmanager.com/gtag/js?id=G-C2K4PMZEDJ";
          document.head.appendChild(script);
        }
        if (!firstPartyPageViewSent) {
          firstPartyPageViewSent = true;
          sendFirstPartyEvent("page_view");
        }
      };
      let analyticsChoice = null;
      try { analyticsChoice = localStorage.getItem(analyticsKey); } catch {}
      if (analyticsChoice === "granted") loadAnalytics();
      if (!analyticsChoice && privacyChoice) privacyChoice.hidden = false;
      document.querySelectorAll("[data-analytics-choice]").forEach((button) => {
        button.addEventListener("click", () => {
          const choice = button.getAttribute("data-analytics-choice");
          try { localStorage.setItem(analyticsKey, choice); } catch {}
          if (choice === "granted") loadAnalytics();
          else {
            try { localStorage.removeItem(analyticsVisitorKey); } catch {}
            if (typeof window.gtag === "function") window.gtag("consent", "update", { analytics_storage: "denied" });
          }
          if (privacyChoice) privacyChoice.hidden = true;
        });
      });
      document.querySelectorAll("[data-reset-analytics]").forEach((button) => {
        button.addEventListener("click", () => {
          try {
            localStorage.removeItem(analyticsKey);
            localStorage.removeItem(analyticsVisitorKey);
          } catch {}
          if (typeof window.gtag === "function") window.gtag("consent", "update", { analytics_storage: "denied" });
          if (privacyChoice) privacyChoice.hidden = false;
        });
      });

      document.addEventListener("click", (event) => {
        const link = event.target instanceof Element
          ? event.target.closest("a[data-affiliate-partner], a[data-retailer][data-affiliate='true']")
          : null;
        if (!(link instanceof HTMLAnchorElement)) return;
        const destination = new URL(link.href, window.location.href);
        const partner = link.dataset.affiliatePartner || link.dataset.retailer || "unknown";
        const context = link.dataset.affiliateContext || link.dataset.commerceContext || "unspecified";
        const placement = link.dataset.affiliatePlacement || context;
        const parameters = {
          affiliate_partner: partner,
          affiliate_placement: placement,
          affiliate_context: context,
          affiliate_club: link.dataset.affiliateClub || "not-applicable",
          destination_host: destination.hostname,
          destination_path: destination.pathname,
          affiliate_link: true,
        };
        window.lsTrack?.("retailer_click", {
          ...parameters,
          retailer: partner,
          commerce_context: context,
        });
      });

      const fantasyActions = {
        "generate-squad": "fantasy_squad_generate",
        "save-squad": "fantasy_plan_save",
        "share-squad": "fantasy_squad_share",
        "download-squad": "fantasy_squad_download",
        "save-chips": "fantasy_plan_save",
        "save-transfer": "fantasy_plan_save",
        "regenerate-kit": "fantasy_mini_league_generate",
        "copy-kit": "fantasy_mini_league_copy",
      };
      document.addEventListener("click", (event) => {
        const element = event.target instanceof Element ? event.target.closest("a,button") : null;
        if (!element) return;
        const action = element.id ? fantasyActions[element.id] : null;
        if (action) window.lsTrack?.(action, { control_id: element.id });
        if (element instanceof HTMLAnchorElement && element.pathname.endsWith(".ics")) {
          window.lsTrack?.("fantasy_reminder_download", { reminder: element.pathname });
        }
        if (element instanceof HTMLAnchorElement && window.location.pathname.startsWith("/fantasy-football/") && element.pathname.startsWith("/fantasy-football/")) {
          window.lsTrack?.("fantasy_internal_click", { destination: element.pathname });
          if (element.pathname === "/fantasy-football/pro/") {
            window.lsTrack?.("fantasy_pro_cta_click", {
              source: "internal_link",
              destination: element.pathname,
            });
          }
        }
      });

      if (window.location.pathname.startsWith("/fantasy-football/")) {
        const seenDepths = new Set();
        const measureDepth = () => {
          const available = document.documentElement.scrollHeight - window.innerHeight;
          if (available <= 0) return;
          const depth = Math.round((window.scrollY / available) * 100);
          [50, 90].forEach((threshold) => {
            if (depth >= threshold && !seenDepths.has(threshold)) {
              seenDepths.add(threshold);
              window.lsTrack?.("fantasy_content_depth", { percent_scrolled: threshold });
            }
          });
        };
        window.addEventListener("scroll", measureDepth, { passive: true });
      }
    </script> <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/v31edd6df95cf4e85bb4c19e7a9bdbcba1788362987495" integrity="sha512-iIg7k2xntmwu6/uSb5tpc/hySgZc4eoL31yB29W6tJFo2akwjPWcEqnCEdJvGexCL0KEQwVYv5BlowfhVz26hg==" data-cf-beacon='{"version":"2024.11.0","token":"d492c18bc5c9475588c0652aa6345e0f","r":1,"spa":2}' crossorigin="anonymous"></script>
</body> </html>