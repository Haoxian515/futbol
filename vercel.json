{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/*.js": {
      "includeFiles": "data/**",
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/live",
      "destination": "/live/",
      "permanent": false
    }
  ]
}
